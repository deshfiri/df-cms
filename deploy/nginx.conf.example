# Example nginx server block for DFCP COMS.
#
# The parts that matter for page-load performance are the gzip block and the
# static-asset location. With these in place, set COMPRESS_RESPONSES=false in
# .env — nginx then handles compression for both PHP output *and* the static
# files under public/, which the PHP middleware cannot reach.
#
# Measured on this app (page + its assets, first visit, uncompressed):
#   /clients HTML                    ~75 KB
#   public/vendor + shell assets    ~830 KB
# gzip takes the HTML to ~17 KB and the CSS/JS to roughly a quarter of their
# size. Only nginx can do the second half.

server {
    listen 80;
    server_name coms.example.com;
    root /var/www/dfcp/public;
    index index.php;

    charset utf-8;

    # ── Compression ──────────────────────────────────────────────────────
    gzip              on;
    gzip_vary         on;          # so caches keep encoded and plain apart
    gzip_proxied      any;
    gzip_comp_level   5;           # past ~6 the CPU is not worth the bytes
    gzip_min_length   1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;
    # text/html is always compressed by nginx and must not be listed.

    # ── Static assets ────────────────────────────────────────────────────
    # Every URL carries ?v=<mtime> (App\Support\ShellAsset), so the URL changes
    # whenever the file does and these can be cached indefinitely.
    location ~* ^/(css|js|vendor)/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ── Laravel ──────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    # Reverb (websockets) — chat, calls and live notifications.
    location /app {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    client_max_body_size 25m;   # chat attachments and document uploads
}
