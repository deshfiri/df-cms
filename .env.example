APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Calendar / Meet integration (optional — meetings work without it)
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# Realtime (chat, presence, live notification bell).
# Echo and pusher-js are loaded from CDN in layouts/app.blade.php and configured
# from these values server-side — there are no VITE_ equivalents and no asset
# build is involved. Changing anything here needs `php artisan config:cache`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# What BROWSERS dial. In production this is the public domain on 443 over https,
# reverse-proxied to the daemon by nginx.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# What the DAEMON binds to. Keep on loopback in production so the port is never
# publicly reachable; nginx is the only way in.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Comma-separated hostnames allowed to open a socket; "*" allows any.
REVERB_ALLOWED_ORIGINS="*"
